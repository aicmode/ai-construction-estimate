# ---------------------------------------------------------------------------
# AI Construction Estimate - environment variables
# Copy to `.env.local` and fill in real values. NEVER commit real values.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project Settings > Data API  /  Project Settings > API Keys
# Safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase service role (server only, OPTIONAL) -------------------------
# Not used by the application or by `npm run db:seed` (the seed signs in as a
# normal user and writes through Row Level Security). Kept here only for local
# administrative scripting. Never expose it to the browser and do not add it to
# Vercel unless you knowingly need server-side admin access.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (optional) ------------------------------------------------
# When unset the app still runs: the rule-based estimate review works and the
# UI reports that the AI layer is not configured.
# Supported values for AI_PROVIDER: "anthropic" | "openai" | "disabled"
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- One-click demo login (optional) ---------------------------------------
# When both are set, the login screen offers a "デモ環境を見る" button that signs
# visitors into this shared demo account. Server-side only: the values are
# never sent to the browser. Leave empty to disable the button safely.
# The account must already exist and its organization must contain seeded data.
#
# This pair only drives the login button. Whether that account can WRITE is
# decided entirely in PostgreSQL by `profiles.is_demo` (migration 0005) — seed
# first, then run:
#   update public.profiles set is_demo = true where email = '<demo address>';
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# --- Seed script (optional) ------------------------------------------------
# Email/password of an existing Supabase Auth user that the demo data will be
# attached to. The user must already exist (sign up through the app first).
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Required (value: yes) to seed a NON-local Supabase project, so demo data can
# never be written to a production database by accident.
SEED_CONFIRM=

# The seed refuses to run twice against the same organization. Set to `yes`
# only if you deliberately want a second copy of the demo data.
SEED_ALLOW_DUPLICATE=
